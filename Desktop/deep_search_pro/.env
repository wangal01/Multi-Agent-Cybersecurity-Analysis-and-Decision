# API 密钥
# LLM配置
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
LLM_QWEN2.5=
LLM_QWEN3=
LLM_QWEN_MAX=

#tavily-api-key
TAVILY_API_KEY=

# 数据库相关配置
MYSQL_USER=root
MYSQL_PASSWORD=073512
MYSQL_DATABASE=asset_vuln_db
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ---------- 本地 RAG（Milvus）----------
# ragflow=远程 RAGFlow  |  milvus=本地向量库（默认）
RAG_BACKEND=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=cybersecurity_kb
# 入库脚本：INGEST_MAX_ROWS=500 先试跑；0 表示全量约 27 万条
INGEST_MAX_ROWS=1000
INGEST_BATCH_SIZE=64
MILVUS_RECREATE=true

# 嵌入模型：fastembed（推荐，无 torch 冲突）| huggingface | openai
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# RAGDATA_JSONL_PATH=rawflow/ragdata/.../xxx.jsonl